# ===== LLM：chat 用 LongCat（美团"龙猫"），embedding 用通义（双供应商，见设计文档 V1.1 §3） =====
# LongCat chat（OpenAI 兼容）。真实端点 base_url=https://api.longcat.chat/openai
# （完整 chat 路径 https://api.longcat.chat/openai/v1/chat/completions）。
# 注意：api.longcat.ai 是错误域名，正确为 api.longcat.chat。
LLM_BASE_URL_CHAT=https://api.longcat.chat/openai
LLM_API_KEY_CHAT=sk-your-longcat-key
LLM_CHAT_MODEL=LongCat-Flash-Chat

# 通义千问 embedding（OpenAI 兼容 /compatible-mode）
LLM_BASE_URL_EMBED=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY_EMBED=sk-your-dashscope-key
LLM_EMBED_MODEL=text-embedding-v3

# ===== Bangumi（只读，仅需 User-Agent，无需 API key；与后端 bangumi.api.* 配置一致） =====
BANGUMI_BASE_URL=https://bgmapi.anibt.net
BANGUMI_USER_AGENT=AcgSpace/1.0 (https://github.com/your-repo)

# ===== 服务 =====
PYTHON_AGENT_PORT=8000
