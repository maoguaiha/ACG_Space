<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="basedir" value="${basedir}"/>

    <!-- 阿里巴巴Java开发手册规则 -->
    <module name="TreeWalker">
        <!-- 包命名 -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z0-9]+)*$"/>
            <property name="message" value="包名必须由小写字母和数字组成"/>
        </module>

        <!-- 类命名 -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <property name="message" value="类名必须以大写字母开头，后跟字母或数字"/>
        </module>

        <!-- 方法命名 -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="message" value="方法名必须以小写字母开头，后跟字母或数字"/>
        </module>

        <!-- 参数命名 -->
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="message" value="参数名必须以小写字母开头，后跟字母或数字"/>
        </module>

        <!-- 变量命名 -->
        <module name="VariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="message" value="变量名必须以小写字母开头，后跟字母或数字"/>
        </module>

        <!-- 常量命名 -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9_]*$"/>
            <property name="message" value="常量名必须全部大写，单词之间用下划线分隔"/>
        </module>

        <!-- 方法长度 -->
        <module name="MethodLength">
            <property name="max" value="150"/>
            <property name="message" value="方法长度超过150行"/>
        </module>

        <!-- 方法参数数量 -->
        <module name="ParameterNumber">
            <property name="max" value="7"/>
            <property name="message" value="方法参数超过7个，建议使用DTO封装"/>
        </module>

        <!-- 行长度 -->
        <module name="LineLength">
            <property name="max" value="120"/>
            <property name="message" value="行长度超过120个字符"/>
        </module>

        <!-- 空行规则 -->
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
        </module>

        <!-- 右大括号位置 -->
        <module name="RightCurly">
            <property name="option" value="same"/>
            <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF"/>
        </module>

        <!-- 避免魔法数字 -->
        <module name="MagicNumber">
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreEnumConstants" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
            <property name="ignoreLocalVariableDeclaration" value="false"/>
            <property name="ignoreMethods" value="true"/>
        </module>

        <!-- 检查 equals 方法 -->
        <module name="EqualsHashCode">
            <property name="equalsMethodsRequired" value="true"/>
            <property name="hashCodeMethodsRequired" value="true"/>
        </module>

        <!-- 检查异常处理 -->
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="java.lang.Exception"/>
        </module>

        <!-- 检查日志使用 -->
        <module name="LoggerName">
            <property name="format" value="^[a-z][a-z0-9]*$"/>
            <property name="message" value="日志变量名必须以小写字母开头"/>
        </module>

        <!-- 检查字符串拼接 -->
        <module name="StringLiteralEquality">
            <property name="ignoreEqualsIgnoreCase" value="true"/>
        </module>

        <!-- 检查未使用的导入 -->
        <module name="UnusedImports"/>

        <!-- 检查导入顺序 -->
        <module name="ImportOrder">
            <property name="groups" value="java,javax,org,com,"/>
            <property name="ordered" value="true"/>
        </module>

        <!-- 检查冗余修饰符 -->
        <module name="RedundantModifier">
            <property name="tokens" value="INTERFACE_DEF, INTERFACE_METHOD_DEF"/>
        </module>

        <!-- 检查数组初始化风格 -->
        <module name="ArrayTypeStyle">
            <property name="option" value="after"/>
        </module>

        <!-- 检查注释 -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
            <property name="authorFormat" value="^\\S+$"/>
            <property name="versionFormat" value="^\\S+$"/>
        </module>

        <!-- 检查空语句块 -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_FINALLY"/>
        </module>

        <!-- 检查括号位置 -->
        <module name="LeftCurly">
            <property name="option" value="nl"/>
        </module>
    </module>
</module>