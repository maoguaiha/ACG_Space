{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build:railway"
  },
  "deploy": {
    "startCommand": "sh -c \"BACKEND_URL=https://authentic-healing-production-ce8a.up.railway.app node server.js\"",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "env": {
      "BACKEND_URL": "https://authentic-healing-production-ce8a.up.railway.app",
      "HOST": "0.0.0.0"
    }
  }
}
