{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build:railway"
  },
  "deploy": {
    "startCommand": "sh -c \"node server.js\"",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "env": {
      "HOST": "0.0.0.0"
    }
  }
}
